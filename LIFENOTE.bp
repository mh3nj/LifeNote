; ==========================================
;          LIFE NOTE v1.0
;    QBasic Blue Screen Edition
;  For the 14-year-old me who loved
;  SCREEN 0, COLOR 11,1, and SOUND
; ==========================================

OpenConsole()
ConsoleTitle("QBasic Life Note - COLOR 11,1")
ConsoleColor(11, 1)   ; Cyan text on deep blue background

; ----- Clear screen manually -----
Procedure ClsScreen()
  ConsoleLocate(1, 1)
  For i = 1 To 2000
    Print(" ")
  Next i
  ConsoleLocate(1, 1)
EndProcedure

ClsScreen()

; ----- QBasic-style beeps -----
Procedure QBeep(freq, duration)
  Beep_(freq, duration)
EndProcedure

; ----- Wait for key -----
Procedure WaitKey()
  ConsoleColor(7, 1)
  PrintN("")
  PrintN("Press any key to continue...")
  ConsoleColor(11, 1)
  Input()
EndProcedure

; ----- Center text on 80-column screen -----
Procedure CenterText(y, text$)
  ConsoleLocate(40 - Len(text$) / 2, y)
  Print(text$)
EndProcedure

; ----- Draw a line across screen -----
Procedure DrawLine(y, char$)
  ConsoleLocate(1, y)
  For i = 1 To 80
    Print(char$)
  Next i
EndProcedure

; ----- Load notes from file -----
Structure NoteData
  date$
  mood$
  text$
EndStructure

Global NewList Notes.NoteData()
Global NotesFile$ = "LIFE_NOTES.TXT"

Procedure LoadNotes()
  ClearList(Notes())
  If ReadFile(0, NotesFile$)
    While Not Eof(0)
      AddElement(Notes())
      Notes()\date$ = ReadString(0)
      Notes()\mood$ = ReadString(0)
      Notes()\text$ = ReadString(0)
    Wend
    CloseFile(0)
  EndIf
EndProcedure

Procedure SaveNotes()
  CreateFile(0, NotesFile$)
  ForEach Notes()
    WriteStringN(0, Notes()\date$)
    WriteStringN(0, Notes()\mood$)
    WriteStringN(0, Notes()\text$)
  Next
  CloseFile(0)
  QBeep(800, 150)
  QBeep(1000, 100)
EndProcedure

; ----- Get today's date (YYYY-MM-DD) -----
Procedure.s TodayDate()
  ProcedureReturn FormatDate("%yyyy-%mm-%dd", Date())
EndProcedure

; ----- Find today's note (returns index or -1) -----
Procedure FindTodayNote()
  today$ = TodayDate()
  i = 0
  ForEach Notes()
    If Notes()\date$ = today$
      ProcedureReturn i
    EndIf
    i + 1
  Next
  ProcedureReturn -1
EndProcedure

; ----- View all past notes -----
Procedure ViewHistory()
  ClsScreen()
  ConsoleColor(14, 1)
  CenterText(2, "=== YOUR PAST NOTES ===")
  ConsoleColor(11, 1)
  
  If ListSize(Notes()) = 0
    CenterText(5, "No notes yet.")
  Else
    row = 5
    ForEach Notes()
      ConsoleLocate(2, row)
      Print(Notes()\date$ + "  [" + Notes()\mood$ + "]  ")
      If Len(Notes()\text$) > 50
          Print(Left(Notes()\text$, 47) + "...")
      Else
          Print(Notes()\text$)
      EndIf
      row + 1
      If row > 22
        WaitKey()
        row = 5
        ClsScreen()
        ConsoleColor(14, 1)
        CenterText(2, "=== YOUR PAST NOTES (cont.) ===")
        ConsoleColor(11, 1)
      EndIf
    Next
  EndIf
  WaitKey()
EndProcedure

; ----- Show statistics -----
Procedure ShowStats()
  ClsScreen()
  ConsoleColor(14, 1)
  CenterText(2, "=== YOUR STATISTICS ===")
  ConsoleColor(11, 1)
  
  If ListSize(Notes()) = 0
    CenterText(5, "No notes yet. Write your life first!")
    WaitKey()
    ProcedureReturn
  EndIf
  
  happy = 0 : sad = 0 : laugh = 0 : cry = 0 : neutral = 0
  
  ForEach Notes()
    Select Notes()\mood$
      Case ":)"   : happy + 1
      Case ":("   : sad + 1
      Case ":D"   : laugh + 1
      Case ";("   : cry + 1
      Case ":|"   : neutral + 1
    EndSelect
  Next
  
  ConsoleLocate(10, 5) : Print("Total notes written: " + Str(ListSize(Notes())))
  ConsoleLocate(10, 7) : Print("Happy  :)  : " + Str(happy))
  ConsoleLocate(10, 8) : Print("Sad    :(  : " + Str(sad))
  ConsoleLocate(10, 9) : Print("Laugh  :D  : " + Str(laugh))
  ConsoleLocate(10, 10) : Print("Cry    ;(  : " + Str(cry))
  ConsoleLocate(10, 11) : Print("Neutral:|  : " + Str(neutral))
  
  ; Find most common mood
  maxCount = happy : bestMood$ = ":)"
  If sad > maxCount : maxCount = sad : bestMood$ = ":(" : EndIf
  If laugh > maxCount : maxCount = laugh : bestMood$ = ":D" : EndIf
  If cry > maxCount : maxCount = cry : bestMood$ = ";(" : EndIf
  If neutral > maxCount : maxCount = neutral : bestMood$ = ":|" : EndIf
  
  ConsoleLocate(10, 13) : Print("Your most common mood: " + bestMood$)
  
  WaitKey()
EndProcedure

; ----- ASCII art from QBasic days -----
Procedure ShowASCIIArt()
  ClsScreen()
  ConsoleColor(14, 1)
  CenterText(2, "=== REMEMBER THIS? ===")
  ConsoleColor(11, 1)
  
  RandomSeed(ElapsedMilliseconds())
  artNum = Random(4)
  
  Select artNum
    Case 0
      PrintN("")
      PrintN("         _______")
      PrintN("        /       \")
      PrintN("       |  :-)    |")
      PrintN("        \_______/")
      PrintN("            |")
      PrintN("            |")
      PrintN("          --+--")
      PrintN("            |")
      PrintN("           / \")
      CenterText(20, "- DOS QBasic Man -")
      
    Case 1
      PrintN("")
      PrintN("        ________________")
      PrintN("       |                |")
      PrintN("       |   [=====]      |")
      PrintN("       |   (o o)        |")
      PrintN("       |    ---         |")
      PrintN("       |   QBasic!      |")
      PrintN("       |________________|")
      CenterText(20, "- Old Computer -")
      
    Case 2
      PrintN("")
      PrintN("          *****")
      PrintN("        **     **")
      PrintN("      **  :D    **")
      PrintN("      **         **")
      PrintN("        **     **")
      PrintN("          *****")
      CenterText(20, "- Smiley Face -")
      
    Case 3
      PrintN("")
      PrintN("        +-----------+")
      PrintN("        |  SCREEN 0 |")
      PrintN("        |  COLOR 11 |")
      PrintN("        |  SOUND     |")
      PrintN("        |  INPUT     |")
      PrintN("        +-----------+")
      CenterText(20, "- My QBasic Setup -")
      
    Case 4
      PrintN("")
      PrintN("            ______")
      PrintN("         .-'      '-.")
      PrintN("        /   LOVE    \")
      PrintN("       |     :)      |")
      PrintN("        \   QBASIC  /")
      PrintN("         '-.______.-'")
      CenterText(20, "- For my 14-year-old self -")
  EndSelect
  
  PrintN("")
  CenterText(23, "Press any key...")
  Input()
EndProcedure

; ----- Daily quote -----
Procedure.s DailyQuote()
  RandomSeed(ElapsedMilliseconds())
  q = Random(9)
  Select q
    Case 0 : ProcedureReturn "Code is poetry that runs."
    Case 1 : ProcedureReturn "One note = one memory saved."
    Case 2 : ProcedureReturn "Your 14-year-old self is smiling."
    Case 3 : ProcedureReturn "Blue screen = safe place."
    Case 4 : ProcedureReturn "Beep beep! You're doing great."
    Case 5 : ProcedureReturn "Print 'Hello World' to yourself today."
    Case 6 : ProcedureReturn "Every day deserves a line of text."
    Case 7 : ProcedureReturn "No internet needed for this feeling."
    Case 8 : ProcedureReturn "QBasic taught us: we can create."
    Case 9 : ProcedureReturn "This note is a gift to future you."
  EndSelect
EndProcedure

; ========== MAIN PROGRAM ==========
LoadNotes()

; Startup splash
ClsScreen()
ConsoleColor(14, 1)
CenterText(5, "╔══════════════════════════════════════╗")
CenterText(6, "║          LIFE NOTE v1.0              ║")
CenterText(7, "║     QBasic Blue Screen Edition        ║")
CenterText(8, "║   For the 14-year-old me inside       ║")
CenterText(9, "╚══════════════════════════════════════╝")
ConsoleColor(11, 1)
CenterText(12, "Loading memories...")
QBeep(600, 200)
Delay(500)
QBeep(800, 200)

; Show ASCII art and quote
ShowASCIIArt()

ClsScreen()
ConsoleColor(14, 1)
CenterText(10, DailyQuote())
ConsoleColor(11, 1)
WaitKey()

; ----- Main loop -----
mainLoop = 1
Repeat
  ClsScreen()
  ConsoleColor(14, 1)
  DrawLine(1, "=")
  CenterText(2, "LIFE NOTE - TODAY IS " + TodayDate())
  DrawLine(4, "=")
  ConsoleColor(11, 1)
  
  ; Check if note exists for today
  todayIndex = FindTodayNote()
  If todayIndex >= 0
    SelectElement(Notes(), todayIndex)
    ConsoleColor(10, 1)
    CenterText(6, "[You already wrote today:]")
    ConsoleColor(11, 1)
    CenterText(7, "Mood: " + Notes()\mood$)
    CenterText(8, Left(Notes()\text$, 70))
    ConsoleColor(14, 1)
    CenterText(10, "Do you want to change it?")
    ConsoleColor(11, 1)
    CenterText(11, "(Y/N)")
    ConsoleLocate(38, 12) : Print("> ")
    change$ = Input()
    If UCase(change$) <> "Y"
      ConsoleColor(14, 1)
      CenterText(14, "Keeping your note. Press any key.")
      WaitKey()
      Continue
    EndIf
    ClsScreen()
  EndIf
  
  ; New note entry
  ConsoleColor(14, 1)
  CenterText(2, "WRITE YOUR LIFE NOTE")
  DrawLine(4, "-")
  ConsoleColor(11, 1)
  
  CenterText(6, "How do you feel?")
  CenterText(7, "  :)  Happy")
  CenterText(8, "  :(  Sad")
  CenterText(9, "  :D  Laughing")
  CenterText(10, "  ;(  Crying")
  CenterText(11, "  :|  Neutral")
  ConsoleLocate(38, 12) : Print("Choice > ")
  mood$ = Input()
  
  Select mood$
    Case ":)", ":(", ":D", ";(", ":|"
      ; valid
    Default : mood$ = ":|"
  EndSelect
  
  ClsScreen()
  ConsoleColor(14, 1)
  CenterText(2, "YOUR NOTE FOR " + TodayDate())
  DrawLine(4, "-")
  ConsoleColor(11, 1)
  CenterText(6, "Type your note (max 200 chars):")
  ConsoleLocate(5, 8)
  Print("> ")
  noteText$ = Input()
  
  If noteText$ = ""
    noteText$ = "(silent day, but still here)"
    QBeep(300, 500)
  Else
    QBeep(1000, 150)
  EndIf
  
  ; Save or update note
  If todayIndex >= 0
    SelectElement(Notes(), todayIndex)
    Notes()\mood$ = mood$
    Notes()\text$ = noteText$
  Else
    AddElement(Notes())
    Notes()\date$ = TodayDate()
    Notes()\mood$ = mood$
    Notes()\text$ = noteText$
  EndIf
  SaveNotes()
  
  ClsScreen()
  ConsoleColor(10, 1)
  CenterText(10, "NOTE SAVED!")
  ConsoleColor(11, 1)
  CenterText(12, "Mood: " + mood$)
  CenterText(13, Left(noteText$, 70))
  QBeep(1200, 200)
  WaitKey()
  
  ; Menu
  ClsScreen()
  ConsoleColor(14, 1)
  CenterText(2, "=== MAIN MENU ===")
  ConsoleColor(11, 1)
  CenterText(5, "1. Write another note")
  CenterText(6, "2. View past notes")
  CenterText(7, "3. Show statistics")
  CenterText(8, "4. See ASCII art again")
  CenterText(9, "5. QUIT (auto backup)")
  ConsoleLocate(38, 11) : Print("Your choice > ")
  choice$ = Input()
  
  Select choice$
    Case "2" : ViewHistory()
    Case "3" : ShowStats()
    Case "4" : ShowASCIIArt()
    Case "5" : mainLoop = 0
  EndSelect
  
Until mainLoop = 0

; ----- Backup and goodbye -----
ClsScreen()
ConsoleColor(14, 1)
CenterText(6, "Backing up your soul...")
SaveNotes()
CopyFile(NotesFile$, "LIFE_NOTES_BACKUP.TXT")
QBeep(400, 300)
QBeep(600, 300)
QBeep(800, 400)

ClsScreen()
ConsoleColor(14, 1)
CenterText(8, "Goodbye, little me.")
CenterText(9, "Keep coding. Keep feeling.")
CenterText(10, "You made it.")
ConsoleColor(11, 1)
CenterText(12, "Press any key to exit.")
Input()
CloseConsole()
End
